\f0\fs24 \cf0 const MEM_ROW_OFFSET = 5;\
const MEM_COL_OFFSET = 3;\
\
function getMemorySheet() \{\
  const ss = SpreadsheetApp.getActiveSpreadsheet();\
  return ss.getSheetByName("Hoja 1") || ss.getActiveSheet();\
\}\
\
function Write(address, value) \{\
  const sheet = getMemorySheet();\
  \
  address = address & 0xFF;\
  value = value & 0xFF;\
\
  const row = Math.floor(address / 16) + MEM_ROW_OFFSET;\
  const col = (address % 16) + MEM_COL_OFFSET;\
\
  const hexString = value.toString(16).toUpperCase().padStart(2, '0');\
\
  const cell = sheet.getRange(row, col);\
  cell.setNumberFormat('@');\
  cell.setValue(hexString);\
\}\
\
function Read(address) \{\
  const sheet = getMemorySheet();\
  address = address & 0xFF;\
\
  const row = Math.floor(address / 16) + MEM_ROW_OFFSET;\
  const col = (address % 16) + MEM_COL_OFFSET;\
\
  let cellValue = sheet.getRange(row, col).getValue().toString().replace("'", "").trim();\
\
  if (!cellValue) return 0;\
  return parseInt(cellValue, 16);\
\}\
\
function TestMemory() \{\
  Write(138, 255);\
\
  let readValue = Read(138);\
  Logger.log("Valor le\'eddo en decimal: " + readValue);\
  Logger.log("Valor le\'eddo en hexadecimal: " + readValue.toString(16).toUpperCase().padStart(2, '0'));\
\}}